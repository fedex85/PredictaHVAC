# Copia este archivo a .env y completa los valores. NO subas .env al repositorio.
GROQ_API_KEY=gsk_tu_clave_aqui
DJANGO_SECRET_KEY=genera-una-clave-larga-y-aleatoria
# Desarrollo: DJANGO_DEBUG=1 es obligatorio para activarlo (por defecto la app arranca en modo seguro/producción)
DJANGO_DEBUG=1
# Añade la IP de tu PC en la red local si pruebas desde el móvil (p. ej. ,192.168.1.175)
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
