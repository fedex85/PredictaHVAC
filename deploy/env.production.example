# Copia como /srv/predicta/app/.env y rellena. Nunca lo subas al repositorio.
DJANGO_DEBUG=0
# Genera una clave:  python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=TU_DOMINIO
DJANGO_CSRF_TRUSTED_ORIGINS=https://TU_DOMINIO
# Sube a 31536000 (1 año) cuando confirmes que todo funciona por HTTPS.
DJANGO_HSTS_SECONDS=3600

# Ruta del panel de administración de Django (no uses /admin/). Cadena larga y aleatoria; la misma en nginx.conf.
# Genera una:  python -c "import secrets; print(secrets.token_urlsafe(24))"
DJANGO_ADMIN_URL=
# Content-Security-Policy: enforce (por defecto) | report-only (solo avisa en la consola) | off
DJANGO_CSP_MODO=enforce

# Detrás de Nginx (Gunicorn en socket Unix) la IP real llega en X-Real-IP; es el valor por defecto en producción.
# Pon 0 solo si NO usas el proxy de Nginx de deploy/nginx.conf.
DJANGO_PROXY_CONFIABLE=1
# Verificación en dos pasos (TOTP) obligatoria para Administrador y Gerente. Déjala en 1.
DJANGO_MFA_OBLIGATORIO=1
# Bloqueo tras N fallos seguidos (usuario + IP) durante M minutos
ACCESO_MAX_FALLOS=5
ACCESO_BLOQUEO_MINUTOS=30
# Horas de inactividad antes de cerrar la sesión y horas de validez de un enlace de contraseña
SESSION_HORAS=12
ENLACE_CLAVE_HORAS=4

DB_NAME=predicta
DB_USER=predicta
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

GROQ_API_KEY=
# Consultas al asistente IA por usuario y hora
IA_LIMITE_POR_HORA=20
# Tope diario de todos los usuarios juntos (protege la cuota de Groq)
IA_LIMITE_DIARIO_GLOBAL=300
# Días de antelación con que se genera la orden preventiva
PREVENTIVOS_ANTICIPACION_DIAS=15

# --- Respaldos (deploy/respaldo.sh; lo lee el script, Django lo ignora) ---
# Clave PÚBLICA age con la que se cifran los respaldos (la privada se guarda fuera del servidor; ver deploy/restaurar.md)
RESPALDO_AGE_DESTINATARIO=
# Copia fuera del servidor (obligatoria): rellena UNA de las dos
RESPALDO_RCLONE_DESTINO=
RESPALDO_RSYNC_DESTINO=

# Correo (informe al cliente y avisos a gestión). Sin EMAIL_HOST los correos solo salen por consola.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=PredictaHVAC <informes@TU_DOMINIO>
# Autónomos: finaliza la orden al cerrar el técnico su parte (1 = activada)
APROBACION_AUTOMATICA=0
